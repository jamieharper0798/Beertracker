rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone in the group can read profiles/leaderboard; you can only edit your own.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Submissions are append-only and readable by any signed-in user.
    match /submissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Shared global counter used to assign sequence numbers and detect milestones.
    match /meta/counter {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
